{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build:app": {
      "dependsOn": ["^build:app"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "BASE_URL",
        "WAKATIME_API_KEY",
        "SPOTIFY_CLIENT_ID",
        "SCREENTIME_API_KEY",
        "SPOTIFY_CLIENT_SECRET",
        "SPOTIFY_REFRESH_TOKEN",
        "LASTFM_API_KEY",
        "LASTFM_USERNAME"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint:fix": {
      "cache": false
    },
    "lint:app": {
      "dependsOn": ["^lint:app"]
    },
    "typecheck:app": {
      "dependsOn": ["^typecheck:app"],
      "env": ["SKIP_ENV_VALIDATION"]
    }
  }
}
