{
  "name": "prudentbird",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build:app": "next build",
    "lint": "turbo run lint:app",
    "build": "turbo run build:app",
    "build:turbo": "turbo run build:app",
    "typecheck": "turbo run typecheck:app",
    "preview": "pnpm run build && next start",
    "lint:app": "eslint . && echo Lint Checks successfully completed!",
    "lint:fix": "eslint --fix . && echo Lint Checks successfully completed!",
    "format": "prettier --write . --cache && echo Prettier Format successfully completed!",
    "typecheck:app": "next typegen && tsgo --pretty --noEmit && echo Type Checks successfuly completed!"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.2.2",
