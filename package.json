    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260403.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "turbo": "^2.9.6",
    "tw-animate-css": "^1.4.0"
  }
