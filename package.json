{
  "name": "prudentbird",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:sudoku": "turbo run dev dev:convex --filter=sudoku",
    "build": "turbo run build:app",
    "build:web": "turbo run build:app --filter=web",
    "build:sudoku": "turbo run build:app --filter=sudoku",
    "lint": "turbo run lint:app",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck:app",
    "format": "prettier --write . --cache && echo Prettier Format successfully completed!"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.11"
  }
}
