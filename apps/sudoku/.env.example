NODE_ENV=development

# ── Next.js (validated in src/env.ts) ────────────────────────────
# Canonical app URL. Used by Better Auth for OAuth redirects.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Printed by `pnpm dev:convex` (npx convex dev) after the deployment starts.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# ── Convex deployment env (set with `npx convex env set NAME value`) ─
# These are read by src/convex/auth.ts on the Convex side, not by Next.
#   SITE_URL              same value as above
#   BETTER_AUTH_SECRET    openssl rand -base64 32
#   GOOGLE_CLIENT_ID      https://console.cloud.google.com/apis/credentials
#   GOOGLE_CLIENT_SECRET
# Google OAuth redirect URI: <SITE_URL>/api/auth/callback/google (Next proxies /api/auth to Convex)
